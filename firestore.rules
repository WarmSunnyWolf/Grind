rules_version = '2';
// Paste these into Firebase console > Firestore Database > Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // Each student's animal in the shared pond. Everyone signed in can see it, only you can change yours.
    match /pond/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }
    // Ripples someone received. Anyone signed in can add one, the list stays short.
    match /ripples/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.resource.data.items.size() <= 30;
    }
    // Commons posts. Only the author can create or delete; others may only add likes and comments.
    match /posts/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.by == request.auth.uid;
      allow update: if signedIn()
        && request.resource.data.by == resource.data.by
        && request.resource.data.title == resource.data.title
        && request.resource.data.body == resource.data.body;
      allow delete: if signedIn() && resource.data.by == request.auth.uid;
    }
    // Study stats shown on someone's profile card. They choose who can read them: only me, friends, or everyone.
    match /stats/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid
        || resource.data.vis == 'everyone'
        || (resource.data.vis == 'friends' && request.auth.uid in resource.data.allow));
      allow write: if signedIn() && request.auth.uid == uid;
    }
    // Grind Together circles, joined by code.
    match /circles/{code} {
      allow read, write: if signedIn();
    }
    // Feedback notes. Anyone can send one, even signed out. Only the owner can read or remove them.
    // Replace YOUR_GOOGLE_EMAIL with your own Google email when you paste this into Firebase.
    match /feedback/{id} {
      allow create: if request.resource.data.keys().hasOnly(['rating','area','like','improve','name','contact','at','page','by'])
        && request.resource.data.like is string && request.resource.data.like.size() <= 2000
        && request.resource.data.improve is string && request.resource.data.improve.size() <= 2000;
      allow read, delete: if signedIn() && request.auth.token.email == "YOUR_GOOGLE_EMAIL";
    }
    // Each student's private progress (timer, pebbles, courses, coins).
    match /data/users/{uid}/{rest=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
  }
}
